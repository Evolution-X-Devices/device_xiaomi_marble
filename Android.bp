soong_namespace {
}

install_symlink {
    name: "firmware_aw_cali.bin_symlink",
    vendor: true,
    installed_location: "firmware/aw_cali.bin",
    symlink_target: "/mnt/vendor/persist/audio/aw_calr.bin",
}

prebuilt_etc {
    name: "RemovePackages",
    src: "remove_packages",
    installable: false,
    overrides: [
        "Gallery", "Gallery2", "Gallery3D", "GalleryNew3D", "Glimpse", "PhotoTable",
    ],
}
